{
  "name": "leqad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An in-workflow CAD learning assistant for Onshape",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @leqad/extension run dev",
    "lint": "eslint apps packages scripts playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "build": "pnpm --recursive --if-present run build",
    "build:edge": "pnpm --filter @leqad/extension run build:edge",
    "package:browsers": "pnpm --filter @leqad/extension run package:browsers",
    "test:e2e": "pnpm --filter @leqad/extension run build:browsers && playwright test",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@testing-library/react": "16.3.3",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
