{
  "name": "leqad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An in-workflow CAD learning assistant for Onshape",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @leqad/extension run dev",
    "lint": "eslint apps packages scripts tools validation playwright.config.ts vitest.reference.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "build": "pnpm --recursive --if-present run build",
    "build:edge": "pnpm --filter @leqad/extension run build:edge",
    "package:browsers": "pnpm --filter @leqad/extension run package:browsers",
    "test:e2e": "pnpm --filter @leqad/extension run build:browsers && playwright test",
    "reference:validate": "node --experimental-strip-types tools/onshape-reference/cli.ts validate",
    "reference:test": "vitest run --config vitest.reference.config.ts",
    "reference:capture": "node --experimental-strip-types tools/onshape-reference/recorder.ts",
    "reference:approve": "node --experimental-strip-types tools/onshape-reference/cli.ts approve",
    "reference:evaluate": "node --experimental-strip-types tools/onshape-reference/cli.ts evaluate",
    "format:check": "prettier --check .",
    "dev:desktop": "node scripts/desktop-dev.mjs",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:test": "vitest run apps/desktop/src packages/desktop-contracts packages/desktop-core",
    "desktop:test:e2e": "playwright test --config apps/desktop/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.5",
    "vitest": "5.0.4"
  }
}
