{
  "name": "@leqad/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt -b chrome",
    "build": "pnpm run build:chrome",
    "build:chrome": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "build:browsers": "pnpm run build:chrome && pnpm run build:edge",
    "package:chrome": "wxt zip -b chrome",
    "package:edge": "wxt zip -b edge",
    "package:browsers": "pnpm run package:chrome && pnpm run package:edge",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@leqad/contracts": "workspace:*",
    "@leqad/lesson-engine": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@wxt-dev/module-react": "1.2.2",
    "vite": "8.3.4",
    "wxt": "0.21.4"
  }
}
